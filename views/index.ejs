<!--
  views/index.ejs
  Main page layout : navbar with Discover / My Watchlist tabs, search bar,
  movie grids (filled in by public/script.js), and the custom-movie form.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CineTrack - Your Movie Companion</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <div class="logo">
        <span class="logo-icon">🎬</span>
        <span class="logo-text">CineTrack</span>
      </div>
      <div class="nav-links">
        <button class="nav-btn active" data-tab="discover">Discover</button>
        <button class="nav-btn" data-tab="watchlist">My Watchlist</button>
      </div>
    </div>
  </nav>

  <main class="container">
    <section class="hero">
      <h1 class="hero-title">
        Discover Your Next <span class="gradient-text">Favorite Movie</span>
      </h1>
      <p class="hero-subtitle">Track, rate, and share your movie journey</p>
      
      <div class="search-container">
        <input 
          type="text" 
          id="searchInput" 
          class="search-input" 
          placeholder="Search for movies..."
        >
        <button id="searchBtn" class="search-btn">Search</button>
      </div>
    </section>

    <section id="discoverTab" class="tab-content active">
      <h2 class="section-title">
        <span class="icon">📈</span> Trending Now
      </h2>
      <div id="trendingMovies" class="movie-grid"></div>
    </section>

    <section id="watchlistTab" class="tab-content">
      <div class="section-header">
        <h2 class="section-title">
          <span class="icon">🎬</span> My Watchlist
        </h2>
        <span id="watchlistCount" class="badge">0 movies</span>
      </div>
      <div id="watchlistMovies" class="movie-grid"></div>
    </section>

    <section class="add-movie-section">
      <h3 class="form-title">Add Custom Movie</h3>
      <div class="form-container">
        <div class="form-group">
          <label for="movieTitle">Movie Title</label>
          <input type="text" id="movieTitle" placeholder="Enter movie title">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="movieYear">Year</label>
            <input type="number" id="movieYear" placeholder="2024">
          </div>
          <div class="form-group">
            <label for="movieRating">Your Rating</label>
            <input type="number" id="movieRating" step="0.1" max="10" placeholder="8.5">
          </div>
        </div>
        <button id="addMovieBtn" class="submit-btn">Add Movie</button>
      </div>
    </section>
  </main>

  <script src="/script.js"></script>
</body>
</html>
